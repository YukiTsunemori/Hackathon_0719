<h1>投稿詳細</h1>


  <div class="card mb-3">
    <div class="card-body d-flex justify-content-between align-items-center">
      <div>
        <h5 class="card-title"><%#= post.user.name %></h5>
        <p class="card-text"><%= @post.text %></p>
      </div>
      <div>
        <%= link_to "削除", post_path(@post), data: { turbo_method: :delete, confirm: "削除しますか？" }, class: "btn btn-danger" %>
        <%= puts "常守" %>
      </div>
    </div>
    <div class="card-footer text-body-secondary justify-content-between align-items-center text-end">
      
      <span class="text-muted">| <%= l @post.created_at, format: :short %></span>
    </div>
  </div>
   <div class="card text-center mt-4 mb-4">
    <div class="card-body">
      <%= simple_form_for [@post, @reply] do |f| %>
        <%= f.input :text, placeholder: "返信を入力してください", class: "form-control" %>
        <%= f.hidden_field :user_id, value: current_user.id %>
        <%= f.button :submit, "Submit", class: "btn btn-primary" %>
    <% end %>
    </div>
  </div>

<% @replies.each do |reply| %>
  <div class="card mb-3 ms-4">
    <div class="card-body">
      <p class="card-text"><%= reply.text %></p>
    <p class="card-text-end">
    <span class="float-end">
      <%= link_to "編集", post_reply_path(@post, reply), class: "btn btn-primary btn-sm" %>
    </span>
    <span class="float-end">
      <%= link_to "削除", post_reply_path(@post, reply), data: { turbo_method: :delete, confirm: "削除しますか？" }, class: "btn btn-danger btn-sm" %>
    </span>
    </p>
    </div>
    <div class="card-footer text-body-secondary justify-content-between align-items-center text-end">
      <span class="text-muted"><%= reply.reply_user %></span>
      <span class="text-muted">| <%= l reply.created_at, format: :short %></span>
    </div>
  </div>
<% end %>

